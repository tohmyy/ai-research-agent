# Postgres connection string. Points at local docker-compose Postgres in
# development, and at Supabase's connection string in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_agent"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Base URL of the FastAPI AI engine (used from Phase 1 onward to trigger pipeline jobs).
FASTAPI_BASE_URL="http://localhost:8000"
