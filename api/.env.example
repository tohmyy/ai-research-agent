# Copy this file to .env and fill in real values as each integration comes online.
# See TDD.md §12 for what each variable is used for. All are optional in Phase 0 —
# the app boots fine with everything left blank.

# Claude API (planning, drafting, evaluation, revision, channel adaptation)
ANTHROPIC_API_KEY=

# Firecrawl (search + scrape)
FIRECRAWL_API_KEY=

# Voyage AI (embeddings)
VOYAGE_API_KEY=

# Supabase (shared Postgres + pgvector) — service key is server-side only
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared Postgres connection string, asyncpg driver
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# This app's own outbound notification email identity (review-ready /
# published / publish-failed emails). LinkedIn/X/newsletter publishing
# credentials are NOT env vars — they're configured at runtime via the
# Settings page and stored in the `channel_configs` table.
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Base URL of the Next.js app, used to build links inside notification emails
APP_BASE_URL=http://localhost:3000
